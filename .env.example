# SQLite file, resolved relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required when not deployed on Vercel
AUTH_TRUST_HOST=true

# Persistent private directory shared by all web instances; must not be under public/
ATTACHMENT_STORAGE_DIR="../crm-system-attachments"
